# Copie ce fichier en ".env" puis remplis les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# --- Base MySQL ---
# En local (WSL) :
DB_HOST=localhost
DB_PORT=3306
DB_USER=ben
DB_PASS=monpassword
DB_NAME=VigoBlue
# En ligne (Aiven) : mets l'hôte, le port, l'utilisateur et le mot de passe donnés par Aiven, et :
# DB_SSL=true

# --- Session (mets n'importe quelle longue phrase secrète) ---
SESSION_SECRET=remplace-moi-par-une-longue-phrase-aleatoire

# --- Stripe (mode test) : https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET=sk_test_...

# --- Seulement en ligne (Render) ---
# NODE_ENV=production
# SITE_URL=https://ton-site.onrender.com
